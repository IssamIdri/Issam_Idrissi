# Origines autorisées par CORS (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optionnel : regex d'origines autorisées (ex. previews Vercel)
# ALLOWED_ORIGIN_REGEX=https://portfolio-issam-ai-.*\.vercel\.app

# Moteur de l'assistant : "rules" (réponses basées sur app/data.py)
ASSISTANT_PROVIDER=rules
# Réservé pour un futur provider LLM (ne jamais committer de vraie clé)
# LLM_API_KEY=

# Envoi des messages de contact : "log" (affichage dans les logs serveur)
CONTACT_PROVIDER=log

LOG_LEVEL=INFO
